# Compose overrides for the local-dev stack. Copy to `.env` (Compose reads it
# automatically) and edit. Everything here has a working default in
# docker-compose.yml, so this file is optional — set only what you need.

# ── product Postgres (service: db) ───────────────────────────────────
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=acme_marketing
POSTGRES_PORT=5432

# ── host port mappings ───────────────────────────────────────────────
API_PORT=8000
N8N_PORT=5678
PGADMIN_PORT=5050

# ── pgAdmin (service: pgadmin) ───────────────────────────────────────
# Email must be a valid format or pgAdmin refuses to boot.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ── app / shared ─────────────────────────────────────────────────────
DEFAULT_TIMEZONE=America/New_York
DEFAULT_BRAND_SLUG=acme-plumbing
# Shared secret between api and n8n. Must match on both (Compose wires it to both).
INTERNAL_API_TOKEN=dev-internal-token
CORS_ORIGINS=http://localhost:5678

# ── n8n ──────────────────────────────────────────────────────────────
# In-network URL n8n uses to reach the API (compose service name). Leave as-is
# unless you point n8n at an API running elsewhere.
N8N_API_BASE_URL=http://api:8000
# Editor/webhook base URL as seen from your browser.
N8N_WEBHOOK_URL=http://localhost:5678/
# Persisted with the n8n_data volume; change to a real 32+ char secret for prod.
N8N_ENCRYPTION_KEY=dev-only-change-me-32chars-min
# Team alert sink for workflows 02/05/07/08 (Slack/Teams incoming webhook).
# Empty => alert nodes fail softly (they are continue-on-error).
INTERNAL_ALERT_WEBHOOK_URL=
REVIEW_REQUEST_DELAY_MINUTES=120
REMINDER_LEAD_HOURS=24

# ── provider keys (reserved; workflows call these through the API) ────
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
GATEWAYAPI_API_TOKEN=
GATEWAYAPI_BASE_URL=https://gatewayapi.com/rest
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=
