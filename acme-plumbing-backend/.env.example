# ── app ──────────────────────────────────────────────────────────────
APP_NAME=Acme Plumbing Marketing Backend
APP_ENV=dev                             # dev | staging | production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
DEFAULT_TIMEZONE=America/New_York

# ── database ─────────────────────────────────────────────────────────
# Plain postgresql:// DSN; the app converts to postgresql+asyncpg:// itself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acme_marketing

# ── CORS (comma-separated origins; empty = middleware disabled) ──────
CORS_ORIGINS=https://acmeplumbing.example,https://www.acmeplumbing.example

# ── Brevo (marketing contacts + lifecycle email — wired later) ───────
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3

# ── GatewayAPI (SMS — wired later) ───────────────────────────────────
GATEWAYAPI_API_TOKEN=
GATEWAYAPI_BASE_URL=https://gatewayapi.com/rest

# ── transactional email providers (wired later) ──────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.acmeplumbing.example
RESEND_API_KEY=

# ── internal auth (n8n / admin callers) ──────────────────────────────
INTERNAL_API_TOKEN=change_me_internal_token

# ── inbound webhook security ─────────────────────────────────────────
# Mailgun: HMAC-SHA256 signing key (Dashboard → Webhooks). Empty ⇒ signatures
#          can't be verified and receipts are marked 'unconfigured'.
MAILGUN_WEBHOOK_SIGNING_KEY=
# Brevo has no HMAC; set a shared secret it echoes back via header/body, or leave
# empty to store+mark payloads 'unverified' (never a false 'verified').
BREVO_WEBHOOK_SECRET=

# ── lifecycle automation ─────────────────────────────────────────────
DEFAULT_REVIEW_URL=https://g.page/r/example/review
REVIEW_REQUEST_DEFAULT_DELAY_MINUTES=120
APPOINTMENT_REMINDER_LEAD_HOURS=24

# Feature flags — disable side-effecting paths without a redeploy.
ENABLE_WEBHOOK_PROCESSING=true          # false ⇒ store raw only, no reconciliation
ENABLE_AUTOMATION_ENDPOINTS=true        # false ⇒ /automations/* returns 503
