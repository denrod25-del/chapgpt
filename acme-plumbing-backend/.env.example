# ── app ──────────────────────────────────────────────────────────────
APP_NAME=Acme Plumbing Marketing Backend
APP_ENV=dev                             # dev | staging | production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
DEFAULT_TIMEZONE=America/New_York

# ── database ─────────────────────────────────────────────────────────
# Plain postgresql:// DSN; the app converts to postgresql+asyncpg:// itself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acme_marketing

# ── CORS (comma-separated origins; empty = middleware disabled) ──────
CORS_ORIGINS=https://acmeplumbing.example,https://www.acmeplumbing.example

# ── Brevo (marketing contacts + lifecycle email — wired later) ───────
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3

# ── GatewayAPI (SMS — wired later) ───────────────────────────────────
GATEWAYAPI_API_TOKEN=
GATEWAYAPI_BASE_URL=https://gatewayapi.com/rest

# ── transactional email providers (wired later) ──────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.acmeplumbing.example
RESEND_API_KEY=

# ── internal auth (n8n / admin callers) ──────────────────────────────
INTERNAL_API_TOKEN=
