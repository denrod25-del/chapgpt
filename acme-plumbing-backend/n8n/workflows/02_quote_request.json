      "parameters": {
        "jsCode": "// Normalize inbound payload -> backend lead schema + stable idempotency key.\nconst b = $input.first().json.body || {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst nameParts = str(b.name).split(' ');\nconst first_name = str(b.first_name) || nameParts[0] || '';\nconst last_name = str(b.last_name) || nameParts.slice(1).join(' ') || null;\nconst email = (str(b.email) || '').toLowerCase() || null;\nconst phone = str(b.phone) || null;\n\n// djb2 string hash: stable idempotency key without needing the crypto module.\nconst djb2 = (s) => { let h = 5381; for (const c of s) h = ((h * 33) ^ c.charCodeAt(0)) >>> 0; return h.toString(16); };\nconst idempotency_key = str(b.submission_id) || ('quote-' + djb2([phone, email, str(b.message), str(b.page_url)].join('|')));\n\nconst errors = [];\nif (!first_name) errors.push('first_name is required');\nif (!email && !phone) errors.push('email or phone is required');\nif (phone && !/^\\+[1-9]\\d{7,14}$/.test(phone)) errors.push('phone must be E.164 (e.g. +15615551212)');\n\nconst urgencyRaw = str(b.urgency).toLowerCase();\nconst is_emergency = ['emergency', 'same_day', 'asap'].includes(urgencyRaw);\n\nconst lead = {\n  brand_slug: str(b.brand_slug) || $env.DEFAULT_BRAND_SLUG || 'acme-plumbing',\n  lead_type: 'quote_request',\n  first_name,\n  last_name,\n  email,\n  phone,\n  service_type: str(b.service_type) || null,\n  urgency: is_emergency ? 'emergency' : 'standard',\n  message: str(b.message) || null,\n  source: str(b.source) || 'website_form',\n  page_url: str(b.page_url) || null,\n  utm: (b.utm && typeof b.utm === 'object') ? b.utm : {},\n  meta: { urgency_raw: urgencyRaw || null },\n  idempotency_key,\n};\nreturn [{ json: { valid: errors.length === 0, error: errors.join('; '), lead, first_name, email, phone, is_emergency } }];"
      },
