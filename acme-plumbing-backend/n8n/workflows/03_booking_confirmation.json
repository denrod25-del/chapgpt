    {
      "parameters": {
        "jsCode": "// Normalize inbound booking payload -> backend booking schema.\nconst b = $input.first().json.body || {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst first_name = str(b.first_name);\nconst last_name = str(b.last_name) || null;\nconst email = (str(b.email) || '').toLowerCase() || null;\nconst phone = str(b.phone) || null;\nconst tz = str(b.timezone) || $env.DEFAULT_TIMEZONE || 'America/New_York';\n\nconst errors = [];\nif (!first_name) errors.push('first_name is required');\nif (!email && !phone) errors.push('email or phone is required');\nif (phone && !/^\\+[1-9]\\d{7,14}$/.test(phone)) errors.push('phone must be E.164');\nconst ts = Date.parse(b.scheduled_for || '');\nif (Number.isNaN(ts)) errors.push('scheduled_for must be a valid ISO datetime');\nelse if (ts < Date.now()) errors.push('scheduled_for must be in the future');\n\nconst when_text = Number.isNaN(ts) ? '' : new Date(ts).toLocaleString('en-US',\n  { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n\nconst booking = {\n  brand_slug: str(b.brand_slug) || $env.DEFAULT_BRAND_SLUG || 'acme-plumbing',\n  lead_id: b.lead_id || null,\n  first_name,\n  last_name,\n  email,\n  phone,\n  scheduled_for: b.scheduled_for,\n  timezone: tz,\n  service_address: (b.service_address && typeof b.service_address === 'object') ? b.service_address : {},\n  notes: str(b.notes) || null,\n};\nreturn [{ json: { valid: errors.length === 0, error: errors.join('; '), booking, first_name, email, phone, when_text } }];"
      },
