    {
      "parameters": {
        "jsCode": "// Compute the reminder send time: scheduled_for - REMINDER_LEAD_HOURS,\n// never in the past (floor: one minute from now).\nconst booking = $input.first().json;\nconst hours = Number($env.REMINDER_LEAD_HOURS) || 24;\nconst tz = booking.timezone || $env.DEFAULT_TIMEZONE || 'America/New_York';\nconst sched = Date.parse(booking.scheduled_for);\nconst target = sched - hours * 3600 * 1000;\nconst reminder_at = new Date(Math.max(target, Date.now() + 60 * 1000)).toISOString();\nconst when_text = new Date(sched).toLocaleString('en-US',\n  { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\nreturn [{ json: { booking_id: booking.id, reminder_at, when_text, scheduled_for: booking.scheduled_for } }];"
      },
      "id": "96d197c1-0950-4f34-8bee-e515d3bba553",
      "name": "Compute Reminder Time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, booking_id: $json.booking_id, reminder_at: $json.reminder_at, next_step: 'wait_until_reminder_window' } }}",
        "options": {}
      },
      "id": "8f3e06ce-e108-4d14-a728-b7647c2ba849",
