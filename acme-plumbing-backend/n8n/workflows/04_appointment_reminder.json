{
  "name": "04 Appointment Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "b1f0c2a1-0001-4a10-9c01-aa0000000001",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/api/v1/automations/appointment-reminders/due",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "b1f0c2a1-0002-4a10-9c01-aa0000000002",
      "name": "Fetch Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Expand the /due array into one item per reminder and pre-format the local\n// appointment time. Skip anything without a booking_id + phone (a failed GET\n// yields an error object with neither, so it produces zero items safely).\nconst rows = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  const arr = Array.isArray(j) ? j : (Array.isArray(j.data) ? j.data : [j]);\n  for (const r of arr) {\n    if (!r || !r.booking_id || !r.phone) continue;\n    const tz = r.timezone || $env.DEFAULT_TIMEZONE || 'America/New_York';\n    let when = r.scheduled_for;\n    try {\n      when = new Date(Date.parse(r.scheduled_for)).toLocaleString('en-US',\n        { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n    } catch (e) { /* keep ISO fallback */ }\n    rows.push({ json: { booking_id: r.booking_id, phone: r.phone,\n      first_name: r.first_name || 'there', scheduled_for: r.scheduled_for, when_text: when } });\n  }\n}\nreturn rows;"
      },
      "id": "b1f0c2a1-0003-4a10-9c01-aa0000000003",
      "name": "Expand Due Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/v1/integrations/gatewayapi/send-sms",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brand_slug: $env.DEFAULT_BRAND_SLUG || 'acme-plumbing', to: $json.phone, message: 'Acme Plumbing: Reminder — your appointment is ' + $json.when_text + '. Reply C to confirm or call us to reschedule.', template: 'sms_reminder' }) }}"
      },
      "id": "b1f0c2a1-0004-4a10-9c01-aa0000000004",
      "name": "Send Reminder SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000041",
              "leftValue": "={{ $json.sent }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1f0c2a1-0005-4a10-9c01-aa0000000005",
      "name": "SMS Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/v1/events",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brand_slug: $env.DEFAULT_BRAND_SLUG || 'acme-plumbing', event_name: 'appointment_reminder_sent', event_source: 'n8n', booking_id: $('Expand Due Reminders').item.json.booking_id, payload: { workflow: '04_appointment_reminder', channel: 'sms', provider_msg_id: $json.provider_msg_id || null } }) }}"
      },
      "id": "b1f0c2a1-0006-4a10-9c01-aa0000000006",
      "name": "Log Reminder Sent Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
