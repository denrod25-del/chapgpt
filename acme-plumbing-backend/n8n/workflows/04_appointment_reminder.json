    {
      "parameters": {
        "jsCode": "// Validate reminder request. Phone must come from the caller: the booking\n// API returns contact_id, not contact details.\nconst b = $input.first().json.body || {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst booking_id = str(b.booking_id);\nconst phone = str(b.phone) || null;\nconst first_name = str(b.first_name) || 'there';\nconst errors = [];\nif (!booking_id) errors.push('booking_id is required');\nif (!phone) errors.push('phone is required');\nif (phone && !/^\\+[1-9]\\d{7,14}$/.test(phone)) errors.push('phone must be E.164');\nreturn [{ json: { valid: errors.length === 0, error: errors.join('; '), booking_id, phone, first_name } }];"
      },
      "id": "ec3b971d-c03f-4b0e-a851-fc9dd131150e",
      "name": "Normalize Reminder Input",
      "type": "n8n-nodes-base.code",
