{
  "name": "05 Review Request",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "b2f0c2a1-0001-4a10-9c01-bb0000000001",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/api/v1/automations/review-requests/due",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "b2f0c2a1-0002-4a10-9c01-bb0000000002",
      "name": "Fetch Due Review Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Expand the /due array into one item per review request. Pick the channel\n// and require the matching contact field so we never dispatch to a blank\n// address. A failed GET yields an object without an id → zero items.\nconst rows = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  const arr = Array.isArray(j) ? j : (Array.isArray(j.data) ? j.data : [j]);\n  for (const r of arr) {\n    if (!r || !r.id) continue;\n    const channel = (r.channel === 'email') ? 'email' : 'sms';\n    if (channel === 'sms' && !r.phone) continue;\n    if (channel === 'email' && !r.email) continue;\n    rows.push({ json: { id: r.id, channel, phone: r.phone || null, email: r.email || null,\n      first_name: r.first_name || 'there', review_url: r.review_url } });\n  }\n}\nreturn rows;"
      },
      "id": "b2f0c2a1-0003-4a10-9c01-bb0000000003",
      "name": "Expand Due Reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000051",
              "leftValue": "={{ $json.channel }}",
              "rightValue": "sms",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2f0c2a1-0004-4a10-9c01-bb0000000004",
      "name": "Channel Is SMS?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/v1/integrations/gatewayapi/send-sms",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brand_slug: $env.DEFAULT_BRAND_SLUG || 'acme-plumbing', to: $json.phone, message: 'Hi ' + $json.first_name + ', thanks for choosing Acme Plumbing! We would love a quick review: ' + $json.review_url, template: 'sms_review_request' }) }}"
      },
      "id": "b2f0c2a1-0005-4a10-9c01-bb0000000005",
      "name": "Send Review SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        -120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/v1/integrations/resend/send-email",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brand_slug: $env.DEFAULT_BRAND_SLUG || 'acme-plumbing', to: $json.email, subject: 'How did we do?', html: '<p>Hi ' + $json.first_name + ',</p><p>Thanks for choosing Acme Plumbing. Please leave us a quick review: ' + $json.review_url + '</p>', template: 'txn_review_request' }) }}"
      },
      "id": "b2f0c2a1-0006-4a10-9c01-bb0000000006",
      "name": "Send Review Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Both channel branches converge here. Normalize the send result and carry\n// the originating review_request id (via paired item) for the mark-* call.\nconst r = $json || {};\nconst rr = $('Expand Due Reviews').item.json;\nreturn [{ json: {\n  review_request_id: rr.id,\n  channel: rr.channel,\n  sent: r.sent === true,\n  provider: r.provider || (rr.channel === 'email' ? 'resend' : 'gatewayapi'),\n  provider_msg_id: r.provider_msg_id || null\n} }];"
      },
      "id": "b2f0c2a1-0007-4a10-9c01-bb0000000007",
      "name": "Normalize Send Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000052",
              "leftValue": "={{ $json.sent }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2f0c2a1-0008-4a10-9c01-bb0000000008",
      "name": "Send Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1060,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/v1/automations/review-requests/{{ $json.review_request_id }}/mark-sent",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ external_message_id: $json.provider_msg_id, provider: $json.provider }) }}"
      },
      "id": "b2f0c2a1-0009-4a10-9c01-bb0000000009",
      "name": "Mark Review Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        -100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/v1/automations/review-requests/{{ $json.review_request_id }}/mark-failed",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ failure_reason: 'send failed via ' + $json.provider }) }}"
      },
      "id": "b2f0c2a1-0010-4a10-9c01-bb0000000010",
      "name": "Mark Review Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        120
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Due Review Requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Review Requests": {
      "main": [
        [
          {
            "node": "Expand Due Reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Due Reviews": {
      "main": [
        [
          {
            "node": "Channel Is SMS?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Is SMS?": {
      "main": [
        [
          {
            "node": "Send Review SMS",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Review Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Review SMS": {
      "main": [
        [
          {
            "node": "Normalize Send Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Review Email": {
      "main": [
        [
          {
            "node": "Normalize Send Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Send Result": {
      "main": [
        [
          {
            "node": "Send Succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Succeeded?": {
      "main": [
        [
          {
            "node": "Mark Review Sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark Review Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "a5000000-0000-4000-8000-000000000005",
  "pinData": {}
}
