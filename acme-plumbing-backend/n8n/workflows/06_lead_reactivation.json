    {
      "parameters": {
        "jsCode": "// Filter the posted batch down to reactivation-eligible contacts.\n// Eligibility: inactive >= min_days_inactive (default 270), reachable by\n// SMS (phone + consent not revoked) or email.\nconst body = $input.first().json.body || {};\nconst contacts = Array.isArray(body.contacts) ? body.contacts : [];\nconst minDays = Number(body.min_days_inactive) || 270;\nconst now = Date.now();\nconst out = [];\nfor (const c of contacts) {\n  const phone = (typeof c.phone === 'string' ? c.phone.trim() : '') || null;\n  const email = (typeof c.email === 'string' ? c.email.trim().toLowerCase() : '') || null;\n  const last = Date.parse(c.last_job_at || c.last_activity_at || '');\n  const days_inactive = Number.isNaN(last) ? null : Math.floor((now - last) / 86400000);\n  if (days_inactive !== null && days_inactive < minDays) continue;\n  const smsOk = !!phone && c.consent_sms !== false;\n  if (!smsOk && !email) continue;\n  out.push({ json: {\n    contact_id: c.contact_id || null,\n    first_name: (typeof c.first_name === 'string' && c.first_name.trim()) || 'there',\n    phone, email,\n    channel: smsOk ? 'sms' : 'email',\n    days_inactive,\n  } });\n}\nif (out.length === 0) return [{ json: { none: true } }];\nreturn out;"
      },
      "id": "046df7a9-dad9-47c7-ad58-9202ccabc3f2",
      "name": "Filter Eligible Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
