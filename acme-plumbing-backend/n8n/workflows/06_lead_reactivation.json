    {
      "parameters": {
        "jsCode": "// Batch summary from the filtered contact list (channel info lives there).\nconst items = $('Filter Eligible Contacts').all().map((i) => i.json);\nreturn [{ json: {\n  success: true,\n  processed: items.length,\n  sms_sent: items.filter((i) => i.channel === 'sms').length,\n  email_synced: items.filter((i) => i.channel === 'email').length,\n} }];"
      },
