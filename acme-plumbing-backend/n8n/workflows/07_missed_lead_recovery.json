      "parameters": {
        "jsCode": "// Validate missed-lead escalation payload. Caller (backend cron or a\n// scheduled query) is responsible for not re-posting the same lead twice.\nconst b = $input.first().json.body || {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst lead_id = str(b.lead_id);\nconst errors = [];\nif (!lead_id) errors.push('lead_id is required');\nreturn [{ json: { valid: errors.length === 0, error: errors.join('; '), lead_id,\n  first_name: str(b.first_name) || 'A customer',\n  phone: str(b.phone) || null,\n  minutes_uncontacted: Number(b.minutes_uncontacted) || null } }];"
      },
