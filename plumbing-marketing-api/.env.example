# App
APP_NAME=Plumbing Marketing API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DEFAULT_TIMEZONE=America/New_York

# Database — canonical async DSN (asyncpg). Alembic derives a sync psycopg DSN.
# In Docker Compose, host is the postgres service name.
DATABASE_URL=postgresql+asyncpg://plumbing_app:change_me@postgres:5432/plumbing_marketing

# Internal auth
INTERNAL_API_TOKEN=

# Integrations
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
GATEWAYAPI_API_TOKEN=
GATEWAYAPI_BASE_URL=https://gatewayapi.com/rest
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=
