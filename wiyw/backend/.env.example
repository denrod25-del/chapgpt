# Read by app/core/config.py unless marked (reserved). Boot-required (fail-fast):
# DATABASE_URL, RESEND_API_KEY, GATEWAYAPI_TOKEN, OWNER_ALERT_PHONE.

# ── app ──────────────────────────────────────────────────────────────
APP_ENV=production                      # production | staging | dev
LOG_LEVEL=INFO
BRAND_PHONE=+15615550100                # ⟨MAIN_PHONE⟩ E.164, shown in comms
OWNER_ALERT_PHONE=+15615550123          # owner's cell for lead/emergency alerts
REVIEW_SHORTLINK_BASE=https://whatsinyourwater.com/r
PRIMARY_BOOKING_URL=                    # ⟨insert⟩ used in email/SMS CTAs
GBP_REVIEW_URL=                         # ⟨insert⟩ Google review deep link

# ── database (system of record) ──────────────────────────────────────
# asyncpg needs a plain TCP DSN — no socket/query-string forms (see MERGE_NOTES.md)
DATABASE_URL=postgresql://user:pass@localhost:5432/wiyw

# ── transactional email: Resend primary ──────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                  # Svix signing secret for /webhooks/resend

# ── transactional email failover + inbound: Mailgun ──────────────────
MAILGUN_API_KEY=                        # also the webhook HMAC signing key
MAILGUN_DOMAIN=mg.whatsinyourwater.com

# ── marketing email: Brevo ───────────────────────────────────────────
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=                    # shared secret appended to the Brevo webhook URL (?token=)
BREVO_LIST_NEW_LEADS=2                  # list_leads (default target of contact upserts)
BREVO_LIST_CUSTOMERS=3                  # list_customers
BREVO_LIST_REACTIVATION=4               # list_reactivation

# ── SMS: GatewayAPI ──────────────────────────────────────────────────
GATEWAYAPI_TOKEN=
GATEWAYAPI_SENDER=WiYW
GATEWAYAPI_WEBHOOK_SECRET=              # shared secret in the DLR webhook URL (?token=)

# ── CMS: Storyblok ───────────────────────────────────────────────────
STORYBLOK_WEBHOOK_SECRET=
STORYBLOK_TOKEN=                        # CDA read token (used by the Next.js app; here for reference)

# ── third-party form vendors → /webhooks/forms ───────────────────────
FORMS_WEBHOOK_TOKEN=                    # shared secret in the vendor webhook URL (?token=)

# ── SEO (import jobs, later phases) ──────────────────────────────────
SEMRUSH_API_KEY=                        # (reserved) position tracking / review monitoring (WF-5)
GSC_SERVICE_ACCOUNT_JSON=               # (reserved) Google service-account file for GSC API

# ── internal auth / webhook security ─────────────────────────────────
INTERNAL_API_TOKEN=                     # bearer for n8n → backend /integrations/* routes
N8N_WEBHOOK_BASE=                       # (reserved) e.g. https://n8n.example.com/webhook

# ── CORS / rate limiting ─────────────────────────────────────────────
CORS_ORIGINS=https://whatsinyourwater.com,https://www.whatsinyourwater.com
RATE_LIMIT_PUBLIC=30/minute             # (reserved) enforce at the reverse proxy for now
