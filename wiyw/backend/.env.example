# Vars marked (v1) are read by planned blueprint code (docs/blueprint/), not yet by app/config.py.

# ── app ──────────────────────────────────────────────────────────────
APP_ENV=production                      # (v1) production | staging | dev
LOG_LEVEL=INFO                          # (v1)
BRAND_PHONE=+15615550100                # ⟨MAIN_PHONE⟩ E.164, shown in comms
OWNER_ALERT_PHONE=+15615550123          # owner's cell for lead/emergency alerts
REVIEW_SHORTLINK_BASE=https://whatsinyourwater.com/r
PRIMARY_BOOKING_URL=                    # (v1) ⟨insert⟩ used in email/SMS CTAs
GBP_REVIEW_URL=                         # (v1) ⟨insert⟩ Google review deep link

# ── database (system of record) ──────────────────────────────────────
# asyncpg needs a plain TCP DSN — no socket/query-string forms (see MERGE_NOTES.md)
DATABASE_URL=postgresql://user:pass@localhost:5432/wiyw

# ── transactional email: Resend primary ──────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                  # (v1) Svix signing secret for /webhooks/resend

# ── transactional email failover + inbound: Mailgun ──────────────────
MAILGUN_API_KEY=                        # also the webhook HMAC signing key
MAILGUN_DOMAIN=mg.whatsinyourwater.com

# ── marketing email: Brevo ───────────────────────────────────────────
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=                    # (v1) shared secret appended to the Brevo webhook URL (?token=)
BREVO_LIST_NEW_LEADS=2                  # (v1) list_leads — currently hardcoded in services/brevo.py
BREVO_LIST_CUSTOMERS=3                  # (v1) list_customers
BREVO_LIST_REACTIVATION=4               # (v1) list_reactivation

# ── SMS: GatewayAPI ──────────────────────────────────────────────────
GATEWAYAPI_TOKEN=
GATEWAYAPI_SENDER=WiYW
GATEWAYAPI_WEBHOOK_SECRET=              # (v1) random path segment for the DLR webhook URL

# ── CMS: Storyblok ───────────────────────────────────────────────────
STORYBLOK_WEBHOOK_SECRET=
STORYBLOK_TOKEN=                        # CDA read token (used by the Next.js app; here for reference)

# ── SEO (import jobs, later phases) ──────────────────────────────────
SEMRUSH_API_KEY=                        # (v1) position tracking / review monitoring (WF-5)
GSC_SERVICE_ACCOUNT_JSON=               # (v1) path to Google service-account file for GSC API

# ── internal auth / webhook security ─────────────────────────────────
INTERNAL_API_TOKEN=                     # (v1) bearer for n8n → backend /integrations/* routes
N8N_WEBHOOK_BASE=                       # (v1) e.g. https://n8n.example.com/webhook

# ── CORS / rate limiting ─────────────────────────────────────────────
CORS_ORIGINS=https://whatsinyourwater.com,https://www.whatsinyourwater.com   # (v1)
RATE_LIMIT_PUBLIC=30/minute             # (v1) public POSTs (leads/quotes/events), per IP
